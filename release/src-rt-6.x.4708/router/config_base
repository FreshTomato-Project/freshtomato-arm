#
# Shared baseline configuration for FreshTomato.
# Platform- and target-specific features are enabled by the build makefiles.
#

# Build and target configuration
TCONFIG_OPTIMIZE_SHARED_LIBS=y
# TCONFIG_BCMARM is not set
# TCONFIG_MIPS_RT is not set
# TCONFIG_MIPS_RTN is not set
# TCONFIG_MIPS_RTAC is not set
# TCONFIG_MIPS is not set
# TCONFIG_MIPSR2 is not set
# TCONFIG_BCMWL6 is not set
# TCONFIG_BCMWL6A is not set
# TCONFIG_BCM7 is not set
# TCONFIG_BCM714 is not set
# TCONFIG_BCMSMP is not set
# TCONFIG_NVRAM_32K is not set
# TCONFIG_NVRAM_64K is not set
# TCONFIG_NVRAM_128K is not set
# TCONFIG_DRAM_512M is not set
# TCONFIG_AIO is not set
# TCONFIG_OPTIMIZE_SIZE is not set
# TCONFIG_OPTIMIZE_SIZE_MORE is not set
# TCONFIG_TRXKEY is not set

# Networking and routing
# TCONFIG_MULTIWAN is not set
# TCONFIG_IPV6 is not set
# TCONFIG_EBTABLES is not set
# TCONFIG_EMF is not set
# TCONFIG_CTF is not set
# TCONFIG_BCMNAT is not set
# TCONFIG_ZEBRA is not set
TCONFIG_L7=y
TCONFIG_L7PAT=y
# TCONFIG_BONDING is not set
# TCONFIG_PROXY is not set
# TCONFIG_MDNS is not set
# TCONFIG_CONNTRACK_TOOL is not set

# VPN, security and cryptography
TCONFIG_L2TP=y
TCONFIG_PPTP=y
# TCONFIG_PPTPD is not set
# TCONFIG_OPENVPN is not set
# TCONFIG_WIREGUARD is not set
# TCONFIG_IPSEC is not set
# TCONFIG_TINC is not set
TCONFIG_HTTPS=y
TCONFIG_ADBLOCK=y
# TCONFIG_DNSSEC is not set
# TCONFIG_OPENSSL30 is not set
# TCONFIG_OPENSSL11 is not set
# TCONFIG_WOLFSSL is not set
# TCONFIG_WOLFSSLMIN is not set
# TCONFIG_KEYGEN is not set
# TCONFIG_HAVEGED is not set

# DNS and network services
TCONFIG_DDNS=y
# TCONFIG_DNSCRYPT is not set
# TCONFIG_STUBBY is not set
# TCONFIG_TOR is not set
# TCONFIG_NOCAT is not set
# TCONFIG_NGINX is not set
